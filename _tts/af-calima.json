""}},"mime":"image/webp"}]},"187710724":{"pageid":187710724,"ns":6,"title":"File:Dust storm across the Algeria-Mali border (Copernicus 2026-04-01).png","index":9,"imagerepository":"local","imageinfo":[{"size":15568132,"width":4961,"height":3508,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png/1920px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1131,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png/3840px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png/1920px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1131,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png/3840px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/fb/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Dust_storm_across_the_Algeria-Mali_border_(Copernicus_2026-04-01).png","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/187710724","extmetadata":{"DateTime":{"value":"2026-04-02 12:06:01","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Dust storm across the Algeria-Mali border (Copernicus 2026-04-01)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Algeria-Mali border|Attribution Copernicus|Photos of Algeria by Sentinel-2|Copernicus files uploaded by OptimusPrimeBot|Photographs taken on 2026-03-30|Satellite pictures of 2026 dust storms","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"On 30 March 2026, a major dust storm formed in the south of Algeria, disrupting trans-Saharan transport routes and affecting air quality across West and North Africa. The storm moved southwards, passing through Mali and Mauritania towards the west coast of Africa throughout the day. It formed a front approximately 2,000 km long, which travelled all the way to the Canary Islands, where a severe \u201cCalima\u201d episode alert was issued. This image, acquired by one of the Copernicus Sentinel-2 satellites on 30 March 2026, shows the dust front moving across the Algeria - Mali border. A dense, pale plume contrasts with the orange linear dunes visible to the south. Copernicus data provide key insight into the extent and dynamics of such dust storm events, supporting atmospheric monitoring, early warning systems, and the assessment of their impacts on infrastructure and regional air quality.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a030 March 2026","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/dust-storm-across-algeria-mali-border\">Dust storm across the Algeria-Mali border</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-2 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2026","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/png"}]},"193134735":{"pageid":193134735,"ns":6,"title":"File:Dust storm across the Algeria-Mali border (Copernicus 2026-04-01).webp","index":10,"imagerepository":"local","imageinfo":[{"size":379318,"width":4961,"height":3508,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp/1920px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1131,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp/3840px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp/1920px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1131,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp/3840px-Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8c/Dust_storm_across_the_Algeria-Mali_border_%28Copernicus_2026-04-01%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Dust_storm_across_the_Algeria-Mali_border_(Copernicus_2026-04-01).webp","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/193134735","extmetadata":{"DateTime":{"value":"2026-05-31 18:11:32","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Dust storm across the Algeria-Mali border (Copernicus 2026-04-01)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Algeria-Mali border|Attribution Copernicus|Photos of Mauritania by Sentinel-2|Photos of Algeria by Sentinel-2|Copernicus files uploaded by OptimusPrimeBot|Photographs taken on 2026-03-30|Satellite pictures of 2026 dust storms","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"On 30 March 2026, a major dust storm formed in the south of Algeria, disrupting trans-Saharan transport routes and affecting air quality across West and North Africa. The storm moved southwards, passing through Mali and Mauritania towards the west coast of Africa throughout the day. It formed a front approximately 2,000 km long, which travelled all the way to the Canary Islands, where a severe \u201cCalima\u201d episode alert was issued. This image, acquired by one of the Copernicus Sentinel-2 satellites on 30 March 2026, shows the dust front moving across the Algeria - Mali border. A dense, pale plume contrasts with the orange linear dunes visible to the south. Copernicus data provide key insight into the extent and dynamics of such dust storm events, supporting atmospheric monitoring, early warning systems, and the assessment of their impacts on infrastructure and regional air quality.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a030 March 2026","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://eu-space.europa.eu/node/3153\">Dust storm across the Algeria-Mali border</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-2 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2026","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/webp"}]},"175256721":{"pageid":175256721,"ns":6,"title":"File:New Calima event in the Canary Islands, Spain (Copernicus 2025-09-19).png","index":3,"imagerepository":"local","imageinfo":[{"size":18348426,"width":3508,"height":4961,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png/1920px-New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2263,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/1/16/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png/1920px-New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2263,"srcset":"https://upload.wikimedia.org/wikipedia/commons/1/16/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/16/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:New_Calima_event_in_the_Canary_Islands,_Spain_(Copernicus_2025-09-19).png","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/175256721","extmetadata":{"DateTime":{"value":"2025-09-19 12:05:40","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"New Calima event in the Canary Islands, Spain (Copernicus 2025-09-19)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Sentinel-3 images|Attribution Copernicus|2025 satellite pictures|Copernicus files uploaded by OptimusPrimeBot|Calima (Sahara dust storm over the Canary Islands) - satellite pictures|Photographs taken on 2025-09-16","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A Calima event affecting the Canary Islands in September 2025 resulted in elevated temperatures, reduced air quality, and increased health risks on the archipelago. As a result, the Spanish State Meteorological Agency (AEMET) issued an orange alert for suspended dust and high air temperatures, while wildfire alerts remained in place across the archipelago. As visible in this Copernicus Sentinel-3 image acquired on 16 September, the suspended Saharan dust was transported towards the Canary Islands by easterly winds associated with a high-pressure system over western Africa.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a016 September 2025","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/new-calima-event-canary-islands-spain\">New Calima event in the Canary Islands, Spain</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2025","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/png"}]},"193150240":{"pageid":193150240,"ns":6,"title":"File:New Calima event in the Canary Islands, Spain (Copernicus 2025-09-19).webp","index":4,"imagerepository":"local","imageinfo":[{"size":640594,"width":3508,"height":4961,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp/1920px-New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2263,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/2/2b/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp/1920px-New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2263,"srcset":"https://upload.wikimedia.org/wikipedia/commons/2/2b/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/2b/New_Calima_event_in_the_Canary_Islands%2C_Spain_%28Copernicus_2025-09-19%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:New_Calima_event_in_the_Canary_Islands,_Spain_(Copernicus_2025-09-19).webp","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/193150240","extmetadata":{"DateTime":{"value":"2026-05-31 23:14:50","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"New Calima event in the Canary Islands, Spain (Copernicus 2025-09-19)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Sentinel-3 images|Attribution Copernicus|2025 satellite pictures|Copernicus files uploaded by OptimusPrimeBot|Calima (Sahara dust storm over the Canary Islands) - satellite pictures|Photos of wildfires by Sentinel satellites|Photographs taken on 2025-09-16","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A Calima event affecting the Canary Islands in September 2025 resulted in elevated temperatures, reduced air quality, and increased health risks on the archipelago. As a result, the Spanish State Meteorological Agency (AEMET) issued an orange alert for suspended dust and high air temperatures, while wildfire alerts remained in place across the archipelago. As visible in this Copernicus Sentinel-3 image acquired on 16 September, the suspended Saharan dust was transported towards the Canary Islands by easterly winds associated with a high-pressure system over western Africa. To support global environmental management and public health initiatives, the Copernicus Atmosphere Monitoring Service delivers key insights into atmospheric composition, alongside global air quality monitoring and forecasting.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a016 September 2025","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://eu-space.europa.eu/node/2065\">New Calima event in the Canary Islands, Spain</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2025","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/webp"}]},"116270077":{"pageid":116270077,"ns":6,"title":"File:Polvo sahariano en Madrid.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":4544559,"width":4000,"height":3000,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Polvo_sahariano_en_Madrid.jpg/1920px-Polvo_sahariano_en_Madrid.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1200,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Polvo_sahariano_en_Madrid.jpg/3840px-Polvo_sahariano_en_Madrid.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Polvo_sahariano_en_Madrid.jpg/1920px-Polvo_sahariano_en_Madrid.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1200,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Polvo_sahariano_en_Madrid.jpg/3840px-Polvo_sahariano_en_Madrid.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Polvo_sahariano_en_Madrid.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Polvo_sahariano_e