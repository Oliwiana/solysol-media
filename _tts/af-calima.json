{"batchcomplete":"","query":{"pages":{"193148385":{"pageid":193148385,"ns":6,"title":"File:Calima in the Canary Islands (Copernicus 2023-08-13).webp","index":5,"imagerepository":"local","imageinfo":[{"size":622312,"width":4647,"height":4151,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp/1920px-Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1429,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp/3840px-Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp/1920px-Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1429,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp/3840px-Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/74/Calima_in_the_Canary_Islands_%28Copernicus_2023-08-13%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Calima_in_the_Canary_Islands_(Copernicus_2023-08-13).webp","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/193148385","extmetadata":{"DateTime":{"value":"2026-05-31 22:40:14","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Calima in the Canary Islands (Copernicus 2023-08-13)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Sentinel-3 images|Attribution Copernicus|Photographs taken on 2023-08-12|2023 in the Canary Islands|2023 satellite pictures|Copernicus files uploaded by OptimusPrimeBot","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"During the second weekend of August 2023, an intense heatwave exerted its influence over the Canary Islands. The maximum air temperatures were above 40\u00b0C in several areas of the archipelago, with peaks of 42\u00b0C in Gran Canaria and 39.2\u00b0C in La Gomera during the night of 12 August. On the same day, the air quality was also affected. As illustrated in this image acquired by one of the Copernicus Sentinel-3 satellites, a Saharan dust storm, commonly referred to as \"calima,\" engulfed the skies of the Islands. The Copernicus Atmosphere Monitoring Service (CAMS) delivers accurate air quality forecasts on both local and global scales.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a012 August 2023","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://eu-space.europa.eu/node/2746\">Calima in the Canary Islands</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2023","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/webp"}]},"151525488":{"pageid":151525488,"ns":6,"title":"File:Dust cloud stretching between the Canary Islands and Cabo Verde (Copernicus 2024-01-26).jpg","index":8,"imagerepository":"local","imageinfo":[{"size":6060006,"width":3507,"height":3522,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg/1920px-Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1607,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/e/ed/Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg/1920px-Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1607,"srcset":"https://upload.wikimedia.org/wikipedia/commons/e/ed/Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/ed/Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_%28Copernicus_2024-01-26%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Dust_cloud_stretching_between_the_Canary_Islands_and_Cabo_Verde_(Copernicus_2024-01-26).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/151525488","extmetadata":{"DateTime":{"value":"2024-08-16 15:08:01","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Dust cloud stretching between the Canary Islands and Cabo Verde (Copernicus 2024-01-26)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Cape Verde|Satellite pictures of algal blooms|Sentinel-3 images|Attribution Copernicus|2024 satellite pictures|Photographs taken on 2024-01-25|Copernicus files uploaded by OptimusPrimeBot|Satellite pictures of 2024 dust storms","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"On 25 January 2024, one of the Copernicus Sentinel-3 satellites acquired this image, showing dust particles being carried by the wind from the Saharan desert over the ocean and extending to the Canary Islands and Cabo Verde. The sand is expected to reduce visibility and affect air quality in the affected areas, but will also contribute to the fertilisation of the ocean and boost the growth of phytoplankton. The Copernicus Atmosphere Monitoring Service provides air quality monitoring and forecasting at the European and global level, which support global environmental management and public health efforts.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a025 January 2024","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/dust-cloud-stretching-between-canary-islands-and-cabo-verde\">Dust cloud stretching between the Canary Islands and Cabo Verde</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2024","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"193144067":{"pageid"