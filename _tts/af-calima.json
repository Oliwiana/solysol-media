index":2,"imagerepository":"local","imageinfo":[{"size":16385161,"width":4961,"height":3508,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png/1920px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1131,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png/3840px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png/1920px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1131,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png/3840px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/4/40/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_dust_plume_over_the_Atlantic_Ocean_(Copernicus_2026-02-20).png","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/184565285","extmetadata":{"DateTime":{"value":"2026-02-20 12:05:35","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saharan dust plume over the Atlantic Ocean (Copernicus 2026-02-20)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Attribution Copernicus|2026 satellite pictures|Atlantic Ocean in 2026|Copernicus files uploaded by OptimusPrimeBot|Satellite pictures of Sahara dust over the Atlantic|Copernicus Atmosphere Monitoring Service","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A widespread Calima episode has carried Saharan dust across the eastern Atlantic Ocean since mid-February 2026, affecting air quality in the archipelagos along the western African coast. As a consequence of the reduced visibility and increased health risks, authorities in the Canary Islands and Cabo Verde issued warnings, inviting residents to limit time spent outdoors. In Madeira, elevated PM10 concentrations associated with the Saharan dust intrusion have also deteriorated air quality. This data visualisation, based on Copernicus Atmosphere Monitoring Service (CAMS) data for 17 February 2026 at 07:00 UTC, shows a vast plume of dust extending from the African coast across the eastern Atlantic Ocean, engulfing the skies of Cabo Verde, the Canary Islands and Madeira. CAMS provides near-real-time monitoring and forecasting of global atmospheric composition, including information on dust transport and intensity, supporting the assessment of the presence and dispersion of atmospheric pollutants and aerosols. Current forecasts indicate that the plume visualised in the image will continue to move towards north-western Europe in the coming days.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"20 February 2026 (upload date)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/saharan-dust-plume-over-atlantic-ocean\">Saharan dust plume over the Atlantic Ocean</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Atmosphere Monitoring Service Data","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2026","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/png"}]},"193134974":{"pageid":193134974,"ns":6,"title":"File:Saharan dust plume over the Atlantic Ocean (Copernicus 2026-02-20).webp","index":1,"imagerepository":"local","imageinfo":[{"size":423940,"width":4961,"height":3508,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp/1920px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1131,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp/3840px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp/1920px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1131,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp/3840px-Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8d/Saharan_dust_plume_over_the_Atlantic_Ocean_%28Copernicus_2026-02-20%29.webp?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_dust_plume_over_the_Atlantic_Ocean_(Copernicus_2026-02-20).webp","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/193134974","extmetadata":{"DateTime":{"value":"2026-05-31 18:15:28","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saharan dust plume over the Atlantic Ocean (Copernicus 2026-02-20)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Attribution Copernicus|2026 satellite pictures|Atlantic Ocean in 2026|Copernicus files uploaded by OptimusPrimeBot|Satellite pictures of Sahara dust over the Atlantic|Copernicus Atmosphere Monitoring Service","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A widespread Calima episode has carried Saharan dust across the eastern Atlantic Ocean since mid-February 2026, affecting air quality in the archipelagos along the western African coast. As a consequence of the reduced visibility and increased health risks, authorities in the Canary Islands and Cabo Verde issued warnings, inviting residents to limit time spent outdoors. In Madeira, elevated PM10 concentrations associated with the Saharan dust intrusion have also deteriorated air quality. This data visualisation, based on Copernicus Atmosphere Monitoring Service (CAMS) data for 17 February 2026 at 07:00 UTC, shows a vast plume of dust extending from the African coast across the eastern Atlantic Ocean, engulfing the skies of Cabo Verde, the Canary Islands and Madeira. CAMS provides near-real-time monitoring and forecasting of global atmospheric composition, including information on dust transport and intensity, supporting the assessment of the presence and dispersion of atmospheric pollutants and aerosols. Current forecasts indicate that the plume visualised in the image will continue to move towards north-western Europe in the coming days.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"20 February 2026 (upload date)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://eu-space.europa.eu/node/3091\">Saharan dust plume over the Atlantic Ocean</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Atmosphere Monitoring Service Data","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2026","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/webp"}]}}}}